#!/usr/bin/env node

const app = require('../app');
const http = require('http');

const port = parseInt(process.env.PORT, 10) || 5000;
app.set('port', port);

const server = http.createServer(app);

server.listen(port);
server.on('listening', () => {
  console.log(`REST API : http://localhost:${port}`);
});
server.on('error', (err) => {
  if (err.code === 'EADDRINUSE') {
    console.error(`Port ${port} is already in use (is another project still running?)`);
    process.exit(1);
  }
  throw err;
});
